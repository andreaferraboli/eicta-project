<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EuphoricBooking" targetNamespace="http://bpmn.io/schema/bpmn" exporter="build_bpmn.py (draft)" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_Artist" name="Artist (management)" processRef="Process_Pool_Artist" />
    <bpmn:participant id="Pool_EE" name="Euphoric Events" processRef="Process_Pool_EE" />
    <bpmn:messageFlow id="Msg_e_propose_a_start" name="booking proposal" sourceRef="e_propose" targetRef="a_start" />
    <bpmn:messageFlow id="Msg_a_accept_e_accept" name="acceptance" sourceRef="a_accept" targetRef="e_accept" />
    <bpmn:messageFlow id="Msg_a_decline_e_decline" name="decline" sourceRef="a_decline" targetRef="e_decline" />
    <bpmn:messageFlow id="Msg_e_contract_a_contract" name="contract" sourceRef="e_contract" targetRef="a_contract" />
    <bpmn:messageFlow id="Msg_a_sign_e_signed" name="signed contract" sourceRef="a_sign" targetRef="e_signed" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Artist" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_Artist">
      <bpmn:lane id="Lane_Artist" name="Artist">
        <bpmn:flowNodeRef>a_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="a_start" name="Booking proposal received">
      <bpmn:outgoing>Flow_a_start_a_eval</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_a_start" />
    </bpmn:startEvent>
    <bpmn:task id="a_eval" name="Evaluate proposal">
      <bpmn:incoming>Flow_a_start_a_eval</bpmn:incoming>
      <bpmn:outgoing>Flow_a_eval_a_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="a_gw" name="Accept?">
      <bpmn:incoming>Flow_a_eval_a_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_a_gw_a_accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_a_gw_a_decline</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="a_accept" name="Send acceptance">
      <bpmn:incoming>Flow_a_gw_a_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_a_accept_a_contract</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="a_decline" name="Send decline">
      <bpmn:incoming>Flow_a_gw_a_decline</bpmn:incoming>
      <bpmn:outgoing>Flow_a_decline_a_end_no</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="a_end_no" name="Proposal declined">
      <bpmn:incoming>Flow_a_decline_a_end_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="a_contract" name="Receive contract">
      <bpmn:incoming>Flow_a_accept_a_contract</bpmn:incoming>
      <bpmn:outgoing>Flow_a_contract_a_sign</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="a_sign" name="Sign and return contract">
      <bpmn:incoming>Flow_a_contract_a_sign</bpmn:incoming>
      <bpmn:outgoing>Flow_a_sign_a_end</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="a_end" name="Contract signed">
      <bpmn:incoming>Flow_a_sign_a_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a_start_a_eval" name="" sourceRef="a_start" targetRef="a_eval" />
    <bpmn:sequenceFlow id="Flow_a_eval_a_gw" name="" sourceRef="a_eval" targetRef="a_gw" />
    <bpmn:sequenceFlow id="Flow_a_gw_a_accept" name="yes" sourceRef="a_gw" targetRef="a_accept" />
    <bpmn:sequenceFlow id="Flow_a_gw_a_decline" name="no" sourceRef="a_gw" targetRef="a_decline" />
    <bpmn:sequenceFlow id="Flow_a_decline_a_end_no" name="" sourceRef="a_decline" targetRef="a_end_no" />
    <bpmn:sequenceFlow id="Flow_a_accept_a_contract" name="" sourceRef="a_accept" targetRef="a_contract" />
    <bpmn:sequenceFlow id="Flow_a_contract_a_sign" name="" sourceRef="a_contract" targetRef="a_sign" />
    <bpmn:sequenceFlow id="Flow_a_sign_a_end" name="" sourceRef="a_sign" targetRef="a_end" />
  </bpmn:process>
  <bpmn:process id="Process_Pool_EE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_EE">
      <bpmn:lane id="Lane_Booking" name="Booking Office">
        <bpmn:flowNodeRef>e_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_propose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_evgw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_decline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_timeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_more</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_PM" name="Program Manager">
        <bpmn:flowNodeRef>e_shortlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_schedule</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DB" name="Festival RDBMS (delivery 1)">
        <bpmn:flowNodeRef>e_query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_update</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Line-up planning opens">
      <bpmn:outgoing>Flow_e_start_e_query</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_e_start">
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="e_query" name="Query stages and free time slots">
      <bpmn:incoming>Flow_e_start_e_query</bpmn:incoming>
      <bpmn:outgoing>Flow_e_query_e_shortlist</bpmn:outgoing>
      <bpmn:property id="Property_e_query_e_db" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataIn_e_query_e_db">
        <bpmn:sourceRef>e_db</bpmn:sourceRef>
        <bpmn:targetRef>Property_e_query_e_db</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="e_shortlist" name="Shortlist artists">
      <bpmn:incoming>Flow_e_query_e_shortlist</bpmn:incoming>
      <bpmn:outgoing>Flow_e_shortlist_e_merge</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="e_merge" name="">
      <bpmn:incoming>Flow_e_shortlist_e_merge</bpmn:incoming>
      <bpmn:incoming>Flow_e_more_e_merge</bpmn:incoming>
      <bpmn:outgoing>Flow_e_merge_e_propose</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="e_propose" name="Send booking proposal to next artist">
      <bpmn:incoming>Flow_e_merge_e_propose</bpmn:incoming>
      <bpmn:outgoing>Flow_e_propose_e_evgw</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="e_evgw" name="">
      <bpmn:incoming>Flow_e_propose_e_evgw</bpmn:incoming>
      <bpmn:outgoing>Flow_e_evgw_e_accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_e_evgw_e_decline</bpmn:outgoing>
      <bpmn:outgoing>Flow_e_evgw_e_timeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="e_accept" name="Acceptance received">
      <bpmn:incoming>Flow_e_evgw_e_accept</bpmn:incoming>
      <bpmn:outgoing>Flow_e_accept_e_register</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_e_accept" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e_decline" name="Decline received">
      <bpmn:incoming>Flow_e_evgw_e_decline</bpmn:incoming>
      <bpmn:outgoing>Flow_e_decline_e_more</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_e_decline" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e_timeout" name="5 days without answer">
      <bpmn:incoming>Flow_e_evgw_e_timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_e_timeout_e_more</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_e_timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="e_more" name="Other shortlisted artists?">
      <bpmn:incoming>Flow_e_decline_e_more</bpmn:incoming>
      <bpmn:incoming>Flow_e_timeout_e_more</bpmn:incoming>
      <bpmn:outgoing>Flow_e_more_e_merge</bpmn:outgoing>
      <bpmn:outgoing>Flow_e_more_e_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_fail" name="No artist booked">
      <bpmn:incoming>Flow_e_more_e_fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="e_register" name="Register performance in DB">
      <bpmn:incoming>Flow_e_accept_e_register</bpmn:incoming>
      <bpmn:outgoing>Flow_e_register_e_schedule</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_e_register_e_db">
        <bpmn:targetRef>e_db</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="e_schedule" name="Assign stage and time slot">
      <bpmn:incoming>Flow_e_register_e_schedule</bpmn:incoming>
      <bpmn:outgoing>Flow_e_schedule_e_update</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="e_update" name="Update performance schedule">
      <bpmn:incoming>Flow_e_schedule_e_update</bpmn:incoming>
      <bpmn:outgoing>Flow_e_update_e_contract</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_e_update_e_db">
        <bpmn:targetRef>e_db</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="e_contract" name="Send contract">
      <bpmn:incoming>Flow_e_update_e_contract</bpmn:incoming>
      <bpmn:outgoing>Flow_e_contract_e_signed</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="e_signed" name="Signed contract received">
      <bpmn:incoming>Flow_e_contract_e_signed</bpmn:incoming>
      <bpmn:outgoing>Flow_e_signed_e_publish</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_e_signed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="e_publish" name="Publish line-up update">
      <bpmn:incoming>Flow_e_signed_e_publish</bpmn:incoming>
      <bpmn:outgoing>Flow_e_publish_e_end</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="e_end" name="Artist booked">
      <bpmn:incoming>Flow_e_publish_e_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="e_db" name="Euphoric Events DB" />
    <bpmn:sequenceFlow id="Flow_e_shortlist_e_merge" name="" sourceRef="e_shortlist" targetRef="e_merge" />
    <bpmn:sequenceFlow id="Flow_e_start_e_query" name="" sourceRef="e_start" targetRef="e_query" />
    <bpmn:sequenceFlow id="Flow_e_query_e_shortlist" name="" sourceRef="e_query" targetRef="e_shortlist" />
    <bpmn:sequenceFlow id="Flow_e_merge_e_propose" name="" sourceRef="e_merge" targetRef="e_propose" />
    <bpmn:sequenceFlow id="Flow_e_propose_e_evgw" name="" sourceRef="e_propose" targetRef="e_evgw" />
    <bpmn:sequenceFlow id="Flow_e_evgw_e_accept" name="" sourceRef="e_evgw" targetRef="e_accept" />
    <bpmn:sequenceFlow id="Flow_e_evgw_e_decline" name="" sourceRef="e_evgw" targetRef="e_decline" />
    <bpmn:sequenceFlow id="Flow_e_evgw_e_timeout" name="" sourceRef="e_evgw" targetRef="e_timeout" />
    <bpmn:sequenceFlow id="Flow_e_decline_e_more" name="" sourceRef="e_decline" targetRef="e_more" />
    <bpmn:sequenceFlow id="Flow_e_timeout_e_more" name="" sourceRef="e_timeout" targetRef="e_more" />
    <bpmn:sequenceFlow id="Flow_e_accept_e_register" name="" sourceRef="e_accept" targetRef="e_register" />
    <bpmn:sequenceFlow id="Flow_e_register_e_schedule" name="" sourceRef="e_register" targetRef="e_schedule" />
    <bpmn:sequenceFlow id="Flow_e_schedule_e_update" name="" sourceRef="e_schedule" targetRef="e_update" />
    <bpmn:sequenceFlow id="Flow_e_update_e_contract" name="" sourceRef="e_update" targetRef="e_contract" />
    <bpmn:sequenceFlow id="Flow_e_contract_e_signed" name="" sourceRef="e_contract" targetRef="e_signed" />
    <bpmn:sequenceFlow id="Flow_e_signed_e_publish" name="" sourceRef="e_signed" targetRef="e_publish" />
    <bpmn:sequenceFlow id="Flow_e_publish_e_end" name="" sourceRef="e_publish" targetRef="e_end" />
    <bpmn:sequenceFlow id="Flow_e_more_e_merge" name="yes" sourceRef="e_more" targetRef="e_merge" />
    <bpmn:sequenceFlow id="Flow_e_more_e_fail" name="no" sourceRef="e_more" targetRef="e_fail" />
  </bpmn:process>
