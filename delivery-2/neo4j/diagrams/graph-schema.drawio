<mxfile host="app.diagrams.net"><diagram id="d1" name="Neo4j graph schema (DRAFT)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;:Person&lt;/b&gt;&lt;br&gt;email (unique)&lt;br&gt;fullName&lt;br&gt;phone" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="210" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;:Purchase&lt;/b&gt;&lt;br&gt;purchaseId (unique)&lt;br&gt;date: Date&lt;br&gt;paymentMethod" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="40" width="210" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;:Ticket&lt;/b&gt;&lt;br&gt;ticketId (unique)&lt;br&gt;type, price: Float&lt;br&gt;validFrom, validTo: Date" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="40" width="210" height="110" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;:Festival&lt;/b&gt;&lt;br&gt;name (unique)&lt;br&gt;location&lt;br&gt;startDate, endDate: Date" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="380" width="210" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;:Stand&lt;/b&gt;&lt;br&gt;name (unique)&lt;br&gt;sponsor" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="380" width="210" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;:Product:Food|Drink|Merchandise&lt;/b&gt;&lt;br&gt;name (unique), price: Float&lt;br&gt;expirationDate: Date (Foo